NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://rastreia:local_rastreia_change_me@localhost:5432/rastreia
# As tabelas e funções da aplicação usam o schema PostgreSQL `rastreia`.
# Web local e origem interna padrão do APK Capacitor Android.
APP_ORIGINS=http://localhost:8100,https://localhost
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=production
RELEASE_VERSION=0.1.0
RELEASE_COMMIT=ae888279b4195941aaf7cf9040275b511d30b60a
# Token exclusivo para scraping de `GET /internal/metrics` (mínimo recomendado: 32 caracteres).
METRICS_BEARER_TOKEN=H7MmzPlxcPLHjMg6NJe4krLtvHzPhS-0JgdpmJPWq90AhyKaujW2UZgCkwGAXiS5
OTEL_SERVICE_NAME=rastreia-backend
# Exemplo: https://otel-collector.interno:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

# Opcional em desenvolvimento. Em produção use rede privada, ACL, autenticação e TLS (`rediss://`).
REDIS_URL=rediss://default:gQAAAAAAAnm8AAIgcDI2YmMwZTg2ZjM3ZjQ0M2NlOTUwMGVkMGQ4M2IyOTliMA@solid-coyote-162236.upstash.io:6379
REDIS_REQUIRED=true
REDIS_KEY_PREFIX=rastreia:staging
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_LOCATION_TTL_SECONDS=900
REDIS_PRESENCE_TTL_SECONDS=120

JWT_ACCESS_SECRET=Wh7L0QgRrHSjayKR212004KprQj3CM6DEwilhFwLhgEYqv-48xA4QO3BnYGozkMp
JWT_REFRESH_SECRET=K7Ds2HFFnbBrBcxIYT59uF0b6wmzg6ak7tDO9_613PZcNFNYAyBOL1QvEqxXuJfD
# Durante rotação, mantenha temporariamente o valor antigo nos campos abaixo.
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=
# Barreira adicional do login Master. Vazio bloqueia novos logins Master.
# Gere com npm run security:generate-master-access-token (nao exibe o valor).
MASTER_ACCESS_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=true

GEOAPIFY_API_KEY=

PUSH_VAPID_SUBJECT=mailto:contato@dominio.com.br
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_APP_URL=http://localhost:8100
PUSH_NOTIFICATION_ICON_URL=
PUSH_NOTIFICATION_BADGE_URL=
PUSH_DEFAULT_OPEN_URL=http://localhost:8100
MESSAGE_PAYLOAD_SECRET=NyRXCy0_ioygpMzXgLWkvipKVf2ggiIODRO_kRAUWkiXqNYlzH9N9Z4le0eB3KmS
NOTIFICATION_WORKER_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=3600
COMMUNICATIONS_MOCK=false

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TRACKING_TEMPLATE=rastreia_acompanhamento
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=

# `local` para desenvolvimento; `s3` para AWS S3, MinIO, R2 e serviços compatíveis.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_PATH=.data/objects
PROOF_MAX_FILE_SIZE_BYTES=5242880
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=auto
S3_BUCKET=nome-do-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# URL da página pública no FRONTEND, não da API/Cloud Run. Inclua /rastrear, sem token.
# Firebase: PUBLIC_TRACKING_BASE_URL=https://rastreiaudi.web.app/rastrear
PUBLIC_TRACKING_BASE_URL=http://localhost:8100/rastrear
TRACKING_TOKEN_PEPPER=vpqut4DdDKRZB0Cb_666Ap5FQEb0BQm1aS23JrnbbW9kyIY5gQZrc8CPS-cYXNnY
TRACKING_TOKEN_TTL_SECONDS=604800
TRACKING_COMPLETED_GRACE_SECONDS=3600
BACKGROUND_TRACKING_SESSION_TTL_SECONDS=43200
RETENTION_LOCATION_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_OPERATIONAL_DAYS=30
RETENTION_BATCH_SIZE=5000
# Revise a política e habilite somente após aprovação jurídica/operacional.
RETENTION_ENABLED=false

BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Rastreia Demo
BOOTSTRAP_ADMIN_NAME=Gestor Demo
BOOTSTRAP_ADMIN_EMAIL=gestor@example.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-local

# Administrador global, separado das contas de tenants. Use `npm run db:seed:platform` uma única vez.
# Convites e verificação de e-mail: URL do FRONT, não da API. Nunca inserir senhas reais neste arquivo.
EMAIL_ACTION_BASE_URL=http://localhost:8100
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Ativar apenas após configurar SMTP e publicar os documentos jurídicos reais em HTTPS.
PUBLIC_COURIER_REGISTRATION_ENABLED=false
TERMS_URL=
PRIVACY_URL=
LEGAL_DOCUMENTS_VERSION=2026-09
# Requer worker em execução contínua; por padrão nenhuma rotina nova de cobrança é ativada.
BILLING_ENABLED=false

BOOTSTRAP_PLATFORM_ADMIN_NAME=Administrador da Plataforma
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=plataforma@example.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=troque-esta-senha-global-local
## iFood: backend only. Never put these secrets in Angular environments.
IFOOD_ENABLED=false
IFOOD_MODE=mock
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_EVENTS_MODE=polling
IFOOD_POLLING_INTERVAL_MS=30000
IFOOD_WEBHOOK_ENABLED=false
# Real webhook signatures use IFOOD_CLIENT_SECRET; override only for mock tests.
IFOOD_WEBHOOK_SECRET=
IFOOD_REQUEST_TIMEOUT_MS=15000
