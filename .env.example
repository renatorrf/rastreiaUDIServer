NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://rastreia:local_rastreia_change_me@localhost:5432/rastreia
# As tabelas e funções da aplicação usam o schema PostgreSQL `rastreia`.
# Web local e origem interna padrão do APK Capacitor Android.
APP_ORIGINS=http://localhost:8100,https://localhost
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=local
RELEASE_VERSION=dev
RELEASE_COMMIT=unknown
# Token exclusivo para scraping de `GET /internal/metrics` (mínimo recomendado: 32 caracteres).
METRICS_BEARER_TOKEN=
OTEL_SERVICE_NAME=rastreia-backend
# Exemplo: https://otel-collector.interno:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1

# Opcional em desenvolvimento. Em produção use rede privada, ACL, autenticação e TLS (`rediss://`).
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=rastreia
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_LOCATION_TTL_SECONDS=900
REDIS_PRESENCE_TTL_SECONDS=120

JWT_ACCESS_SECRET=troque-por-ao-menos-32-caracteres-aleatorios
JWT_REFRESH_SECRET=troque-por-outros-32-caracteres-aleatorios
# Durante rotação, mantenha temporariamente o valor antigo nos campos abaixo.
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false

GEOAPIFY_API_KEY=

PUSH_VAPID_SUBJECT=mailto:contato@dominio.com.br
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_APP_URL=http://localhost:8100
PUSH_NOTIFICATION_ICON_URL=
PUSH_NOTIFICATION_BADGE_URL=
PUSH_DEFAULT_OPEN_URL=http://localhost:8100
MESSAGE_PAYLOAD_SECRET=troque-por-segredo-exclusivo-de-ao-menos-32-caracteres
NOTIFICATION_WORKER_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=3600
COMMUNICATIONS_MOCK=false

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TRACKING_TEMPLATE=rastreia_acompanhamento
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=

# `local` para desenvolvimento; `s3` para AWS S3, MinIO, R2 e serviços compatíveis.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PATH=.data/objects
PROOF_MAX_FILE_SIZE_BYTES=5242880
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

PUBLIC_TRACKING_BASE_URL=http://localhost:8100/rastrear
TRACKING_TOKEN_PEPPER=troque-por-ao-menos-32-caracteres-aleatorios
TRACKING_TOKEN_TTL_SECONDS=604800
TRACKING_COMPLETED_GRACE_SECONDS=3600
BACKGROUND_TRACKING_SESSION_TTL_SECONDS=43200
RETENTION_LOCATION_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_OPERATIONAL_DAYS=30
RETENTION_BATCH_SIZE=5000
# Revise a política e habilite somente após aprovação jurídica/operacional.
RETENTION_ENABLED=false

BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Rastreia Demo
BOOTSTRAP_ADMIN_NAME=Gestor Demo
BOOTSTRAP_ADMIN_EMAIL=gestor@example.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-local

# Administrador global, separado das contas de tenants. Use `npm run db:seed:platform` uma única vez.
BOOTSTRAP_PLATFORM_ADMIN_NAME=Administrador da Plataforma
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=plataforma@example.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=troque-esta-senha-global-local
